# Optional Paperclip auth. Localhost URLs can omit PAPERCLIP_TOKEN.
PAPERCLIP_API_URL=http://127.0.0.1:3100
PAPERCLIP_COMPANY_ID=
PAPERCLIP_TOKEN=

# Scheduler cadence and safety.
AUTOMIXER_VECTOR_SYNC_INTERVAL_SECONDS=900
AUTOMIXER_VECTOR_SYNC_DRY_RUN=false

# Optional local overrides.
AUTOMIXER_VECTOR_SYNC_PERSIST_DIR=.chromadb
AUTOMIXER_VECTOR_SYNC_COLLECTION=automixer-project
AUTOMIXER_VECTOR_SYNC_STATE=.paperclip/vector_paperclip_sync_state.json
AUTOMIXER_VECTOR_SYNC_LOCK=.paperclip/vector_paperclip_sync.lock
AUTOMIXER_VECTOR_SYNC_LOG=logs/automixer_vector_paperclip_sync.log
