{
  "name": "automixer-wing-frontend",
  "version": "1.0.0",
  "author": "AUTO MIXER Team",
  "description": "Auto Mixer for Behringer Wing Rack",
  "main": "public/electron.js",
  "homepage": "./",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.22.3",
    "npm": "10.9.8"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/osx-sign": "1.0.5",
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.2",
    "electron": "43.1.0",
    "electron-builder": "24.13.3",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "vite": "^7.0.0",
    "wait-on": "^7.2.0"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test src/services/__tests__/websocketCore.test.mjs src/services/__tests__/remoteAuthPolicy.test.mjs src/services/__tests__/electronSecurityContract.test.mjs src/services/__tests__/macosSigningContract.test.mjs src/services/__tests__/macosBuildProfilesContract.test.mjs src/services/__tests__/macosReleaseVerifier.test.mjs src/services/__tests__/packagingArchitecture.test.mjs src/services/__tests__/operatorStatusTone.test.mjs src/components/__tests__/autoSoundcheckSummary.test.mjs src/components/__tests__/dashboardReadOnlyContract.test.mjs src/components/__tests__/frontendTruthContract.regression-1.test.mjs src/components/__tests__/soundcheckCockpitContract.test.mjs src/services/__tests__/operatorAdaptersContract.test.mjs",
    "test:e2e": "playwright test",
    "test:packaged-runtime": "node scripts/smoke-packaged-runtime.mjs",
    "mac:local": "node scripts/build-macos.mjs --profile local",
    "mac:release": "node scripts/build-macos.mjs --profile release",
    "mac:verify-release": "node scripts/verify-macos-release.mjs",
    "electron": "electron .",
    "electron:dev": "electron .",
    "electron:build": "npm run mac:local",
    "electron:build:mac": "npm run mac:local",
    "dist:frontend": "npm run mac:local",
    "dist": "npm run mac:local",
    "build:backend": "cd .. && AUTOMIXER_TARGET_ARCH=arm64 ./build_backend.sh"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.automixer.wing",
    "productName": "AUTO MIXER Tubeslave",
    "afterPack": "scripts/after-pack-macos.cjs",
    "files": [
      "build/**/*",
      "public/electron.js",
      "public/electronSecurity.js",
      "public/preload.js",
      "public/icon.png"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/server",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../config/default_config.json",
        "to": "config/default_config.json"
      },
      {
        "from": "../config/automixer.yaml",
        "to": "config/automixer.yaml"
      },
      {
        "from": "../config/muq_eval.yaml",
        "to": "config/muq_eval.yaml"
      },
      {
        "from": "../config/perceptual.yaml",
        "to": "config/perceptual.yaml"
      },
      {
        "from": "../config/source_knowledge.yaml",
        "to": "config/source_knowledge.yaml"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "timestamp": null,
      "entitlements": "public/entitlements.mac.plist",
      "entitlementsInherit": "public/entitlements.mac.inherit.plist",
      "sign": "scripts/sign-macos.cjs",
      "strictVerify": true,
      "extendInfo": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "directories": {
      "buildResources": "public",
      "output": "dist"
    }
  }
}
