{
  "name": "automixer-wing-frontend",
  "version": "1.0.0",
  "author": "AUTO MIXER Team",
  "description": "Auto Mixer for Behringer Wing Rack",
  "main": "public/electron.js",
  "homepage": "./",
  "private": true,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "vite": "^7.0.0",
    "wait-on": "^7.2.0"
  },
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test src/services/__tests__/websocketCore.test.mjs src/components/__tests__/autoSoundcheckSummary.test.mjs src/components/__tests__/dashboardReadOnlyContract.test.mjs src/components/__tests__/frontendTruthContract.regression-1.test.mjs src/components/__tests__/soundcheckCockpitContract.test.mjs src/services/__tests__/operatorAdaptersContract.test.mjs",
    "test:e2e": "playwright test",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build:backend && npm run build && electron-builder",
    "electron:build:mac": "npm run build:backend && npm run build && electron-builder --mac",
    "dist:frontend": "npm run build && electron-builder --mac zip --dir --publish never",
    "dist": "npm run build:backend && npm run dist:frontend",
    "build:backend": "cd .. && ./build_backend.sh"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.automixer.wing",
    "productName": "AUTO MIXER Tubeslave",
    "files": [
      "build/**/*",
      "public/electron.js",
      "public/preload.js",
      "public/icon.png"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/server",
        "to": "backend/server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../config/default_config.json",
        "to": "config/default_config.json"
      },
      {
        "from": "../config/automixer.yaml",
        "to": "config/automixer.yaml"
      },
      {
        "from": "../config/muq_eval.yaml",
        "to": "config/muq_eval.yaml"
      },
      {
        "from": "../config/perceptual.yaml",
        "to": "config/perceptual.yaml"
      },
      {
        "from": "../config/source_knowledge.yaml",
        "to": "config/source_knowledge.yaml"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "timestamp": null,
      "entitlements": "public/entitlements.mac.plist",
      "entitlementsInherit": "public/entitlements.mac.plist"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "directories": {
      "buildResources": "public",
      "output": "dist"
    }
  }
}
