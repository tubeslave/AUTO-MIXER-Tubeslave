+        ],
+    )
+
+    summary = audit.build_audit_summary([evidence], min_duration_sec=600.0)
+
+    assert summary["status"] == "passed"
+    assert summary["positive_gain_or_trim_boost_count"] == 0
+    assert summary["relative_only_target_count"] == 0
