+# ADR: Operator Review Proposal Coverage
+
+## Context
+
+The supervised soundcheck MVP requires operators to see what is being proposed,
+why it is proposed, the risk, old/new value and rollback path. M005 and M006
+remain external validation gates, so unattended work cannot use this visibility
+work to grant apply authority.
+
+## Options considered
+
+1. Enforce complete proposal context in `OperatorProposalQueue.create`.
+2. Add a read-only coverage summary to `build_decision_queue`.
+3. Leave the UI to infer missing fields from raw proposal payloads.
+
+## Decision
+
+Add `summary.operator_review_contract` to `build_decision_queue`. It checks
+pending proposals for `reason`, `risk`, `requested_change`, `old_value`,
+`new_value` and `rollback` context, and reports complete/incomplete coverage.
+
+## Why this won
+
+The summary makes proposal quality auditable without changing apply gates,
+proposal creation, queue mutation or live authority.
+
+## Rejected alternatives
+
+- Enforcing completeness at creation could break existing analysis-only and
+  transitional proposals before the UI can display the gaps.
+- UI-only inference would be harder to test and would not give backend evidence
+  for runtime audits.
+
+## Implementation plan
+
+1. Add read-only helper functions in `backend/operator_product_state.py`.
+2. Include coverage counts and rows in `decision_queue.summary`.
+3. Add tests for complete and incomplete pending proposals.
+4. Record the scope as operator visibility only in truth surfaces.
+
+## Test plan
+
+- `PYTHONPATH=backend python3 -m pytest tests/test_operator_product_state.py -k "operator_review_field_coverage or operator_review_incomplete_fields or decision_queue_summarizes_apply_preflight_candidates or operator_proposal_queue_accepts_assist_suggestions" -q`
+- `python3 -m py_compile backend/operator_product_state.py`
+
+## Risks and rollback
+
+The risk is treating coverage completeness as permission to apply. The summary
+therefore carries `live_write=false` and only reports missing fields. Rollback
+is to remove the summary helper, tests and truth-surface entries; no live state
+is touched.
diff --git a/tools/soundcheck_runtime_observation_runner.py b/tools/soundcheck_runtime_observation_runner.py
new file mode 100644
index 000000000..3898397e3
--- /dev/null
+++ b/tools/soundcheck_runtime_observation_runner.py
@@ -0,0 +1,388 @@
+#!/usr/bin/env python3
+"""Collect read-only soundcheck runtime telemetry over the backend WebSocket.
+
+The runner is intentionally telemetry-only. It never creates proposals, never
+applies proposals, never changes operator mode, and never sends direct mixer
+write requests. It writes an artifact that can prove the dashboard/meter loop
+was alive while live-authority surfaces stayed quiet.
+"""
+
+from __future__ import annotations
+
+import argparse
+import asyncio
+import json
+import sys
+import time
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any, Dict, Optional
+
+import websockets
+
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+DEFAULT_ARTIFACT_ROOT = "artifacts/soundcheck_runtime_observation"
+
+READ_REQUESTS = (
+    {"type": "get_operator_mode"},
+    {"type": "get_dashboard_snapshot"},
+    {"type": "get_channel_inventory", "total_channels": 48},
+    {"type": "get_decision_queue", "limit": 50},
+    {"type": "get_safety_monitor"},
+)
+WRITE_REQUEST_TYPES = {
+    "set_operator_mode",
+    "create_operator_proposal",
+    "accept_operator_proposal",
+    "dismiss_operator_proposal",
+    "apply_operator_proposal",
+    "execute_operator_proposal_apply_sequence",
+    "execute_operator_proposal_apply_sequence_policy_memory_trust_promotion",
+    "connect_wing",
+    "disconnect_wing",
+    "disconnect_mixer",
+    "set_fader",
+    "set_gain",
+    "set_mute",
+    "mute_channel",
+    "unmute_channel",
+    "set_pan",
+    "set_eq",
+    "set_compressor",
+    "set_gate",
+    "set_fx",
+    "route_output",
+    "load_snap",
+    "save_snap",
+    "rollback_last_manual_write",
+    "emergency_stop",
+}
+LIVE_EVENT_TYPES = {
+    "operator_proposal_apply_result",
+    "manual_write_rollback_applied",
+    "manual_write_rollback_blocked",
+    "manual_write_rollback_error",
+    "emergency_stop_applied",
+    "voice_command_executed",
+}
+
+
+def utc_stamp() -> str:
+    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
+
+
+def iso_now() -> str:
+    return datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")
+
+
+def json_default(value: Any) -> Any:
+    try:
+        return str(value)
+    except Exception:
+        return "<unserializable>"
+
+
+class EventRecorder:
+    def __init__(self, run_dir: Path):
+        self.run_dir = run_dir
+        self.events_path = run_dir / "events.jsonl"
+        self.summary_path = run_dir / "summary.json"
+        self.seq = 0
+        self.sent_request_types: list[str] = []
+        self.recv_event_types: list[str] = []
+
+    def record(self, event_type: str, payload: Dict[str, Any]) -> None:
+        self.seq += 1
+        payload_type = str(payload.get("type") or "unknown")
+        if event_type == "send":
+            self.sent_request_types.append(payload_type)
+        if event_type == "recv":
+            self.recv_event_types.append(payload_type)
+        event = {
+            "seq": self.seq,
+            "timestamp": datetime.now(timezone.utc)
+            .isoformat(timespec="milliseconds")
+            .replace("+00:00", "Z"),
+            "event_type": event_type,
+            "payload": payload,
+        }
+        with self.events_path.open("a", encoding="utf-8") as handle:
+            handle.write(json.dumps(event, ensure_ascii=False, sort_keys=True, default=json_default))
+            handle.write("\n")
+
+    def write_summary(self, summary: Dict[str, Any]) -> None:
+        summary = dict(summary)
+        sent_request_types = list(self.sent_request_types)
+        recv_event_types = list(self.recv_event_types)
+        forbidden_sent = sorted({item for item in sent_request_types if item in WRITE_REQUEST_TYPES})
+        summary.setdefault("events_path", str(self.events_path))
+        summary.setdefault("summary_path", str(self.summary_path))
+        summary.setdefault("sent_request_types", sent_request_types)
+        summary.setdefault("received_event_types", recv_event_types)
+        summary.setdefault("forbidden_request_types_sent", forbidden_sent)
+        summary.setdefault("write_request_sent", bool(forbidden_sent))
+        summary.setdefault("live_apply_request_sent", "apply_operator_proposal" in sent_request_types)
+        with self.summary_path.open("w", encoding="utf-8") as handle:
+            json.dump(summary, handle, ensure_ascii=False, indent=2, sort_keys=True, default=json_default)
+            handle.write("\n")
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(
+        description="Collect read-only soundcheck dashboard/meter telemetry."
+    )
+    parser.add_argument("--url", default="ws://localhost:8765")
+    parser.add_argument("--duration-sec", type=float, default=600.0)
+    parser.add_argument("--sample-interval-sec", type=float, default=5.0)
+    parser.add_argument("--recv-timeout-sec", type=float, default=0.5)
+    parser.add_argument("--max-events", type=int, default=0)
+    parser.add_argument("--artifact-root", default=DEFAULT_ARTIFACT_ROOT)
+    parser.add_argument("--reason", default="soundcheck_runtime_observation")
+    return parser
+
+
+def validate_args(args: argparse.Namespace) -> Optional[str]:
+    if args.duration_sec < 0 or args.duration_sec > 3600:
+        return "--duration-sec must be between 0 and 3600"
+    if args.sample_interval_sec <= 0 or args.sample_interval_sec > 120:
+        return "--sample-interval-sec must be between 0 and 120"
+    if args.recv_timeout_sec <= 0 or args.recv_timeout_sec > 10:
+        return "--recv-timeout-sec must be between 0 and 10"
+    if args.max_events < 0:
+        return "--max-events must be non-negative"
+    return None
+
+
+def _is_unexpected_live_event(payload: Dict[str, Any]) -> bool:
+    payload_type = payload.get("type")
+    if payload_type in LIVE_EVENT_TYPES:
+        if payload_type == "operator_proposal_apply_result":
+            return payload.get("status") == "applied" or (
+                isinstance(payload.get("apply_result"), dict)
+                and payload["apply_result"].get("status") == "applied"
+            )
+        return True
+    if payload.get("live_write") is True:
+        return True
+    return False
+
+
+def _dashboard_fields(payload: Dict[str, Any]) -> Dict[str, Any]:
+    if payload.get("type") != "dashboard_snapshot":
+        return {}
+    analyzer = payload.get("analyzer")
+    master = payload.get("master_bus")
+    connection = payload.get("connection")
+    return {
+        "has_connection": isinstance(connection, dict),
+        "has_master_bus": isinstance(master, dict),
+        "has_analyzer": isinstance(analyzer, dict),
+        "analyzer_available": bool(isinstance(analyzer, dict) and analyzer.get("available")),
+        "master_bus_available": bool(isinstance(master, dict) and master.get("available")),
+    }
+
+
+async def _send(ws: Any, recorder: EventRecorder, payload: Dict[str, Any]) -> None:
+    recorder.record("send", payload)
+    await ws.send(json.dumps(payload))
+
+
+async def _send_sample_requests(ws: Any, recorder: EventRecorder) -> None:
+    for request in READ_REQUESTS:
+        await _send(ws, recorder, dict(request))
+
+
+async def run(args: argparse.Namespace) -> int:
+    run_id = f"{utc_stamp()}_soundcheck_runtime_observation"
+    run_dir = Path(args.artifact_root) / run_id
+    run_dir.mkdir(parents=True, exist_ok=True)
+    recorder = EventRecorder(run_dir)
+    started_monotonic = time.monotonic()
+    deadline = started_monotonic + float(args.duration_sec)
+    summary: Dict[str, Any] = {
+        "run_id": run_id,
+        "schema": "soundcheck_runtime_observation.v1",
+        "runner": "soundcheck_runtime_observation_runner",
+        "status": "started",
+        "started_at": iso_now(),
+        "url": args.url,
+        "reason": args.reason,
+        "duration_target_sec": args.duration_sec,
+        "sample_interval_sec": args.sample_interval_sec,
+        "read_only": True,
+        "live_write": False,
+        "live_authority_granted": False,
+        "readiness_closure_allowed": False,
+        "readiness_matrix_update_allowed": False,
+        "m005_closure_allowed": False,
+        "m006_closure_allowed": False,
+        "proof_scope": "runtime_telemetry_only_no_wing_readiness",
+        "counts": {
+            "dashboard_snapshot": 0,
+            "meter_frame": 0,
+            "channel_inventory": 0,
+            "decision_queue": 0,
+            "safety_monitor": 0,
+            "operator_mode_status": 0,
+            "connection_status": 0,
+            "unexpected_live_event": 0,
+        },
+        "dashboard_contract": {
+            "has_connection": False,
+            "has_master_bus": False,
+            "has_analyzer": False,
+            "analyzer_available_count": 0,
+            "master_bus_available_count": 0,
+        },
+        "meter_contract": {
+            "subscribed": False,
+            "read_only_frames": 0,
+            "live_write_frames": 0,
+            "available_frames": 0,
+            "max_channel_count": 0,
+        },
+        "unexpected_live_events": [],
+    }
+
+    validation_error = validate_args(args)
+    if validation_error:
+        summary.update({"status": "blocked", "reason": validation_error})
+        recorder.write_summary(summary)
+        print(json.dumps(summary, indent=2, sort_keys=True, default=json_default))
+        return 2
+
+    try:
+        async with websockets.connect(args.url) as ws:
+            await _send(ws, recorder, {"type": "subscribe_meters"})
+            await _send_sample_requests(ws, recorder)
+            next_sample = time.monotonic() + float(args.sample_interval_sec)
+            while True:
+                now = time.monotonic()
+                if args.max_events and len(recorder.recv_event_types) >= args.max_events:
+                    break
+                if now >= deadline and args.duration_sec > 0:
+                    break
+                if now >= next_sample:
+                    await _send_sample_requests(ws, recorder)
+                    next_sample = now + float(args.sample_interval_sec)
+                timeout = min(float(args.recv_timeout_sec), max(0.01, deadline - now))
+                try:
+                    raw = await asyncio.wait_for(ws.recv(), timeout=timeout)
+                except asyncio.TimeoutError:
+                    if args.duration_sec == 0:
+                        break
+                    continue
+                try:
+                    payload = json.loads(raw)
+                except json.JSONDecodeError:
+                    payload = {"type": "invalid_json", "raw": raw}
+                if not isinstance(payload, dict):
+                    payload = {"type": "non_object_payload", "payload": payload}
+                recorder.record("recv", payload)
+                payload_type = str(payload.get("type") or "unknown")
+                if payload_type in summary["counts"]:
+                    summary["counts"][payload_type] += 1
+                if _is_unexpected_live_event(payload):
+                    summary["counts"]["unexpected_live_event"] += 1
+                    summary["unexpected_live_events"].append(payload)
+
+                if payload_type == "meter_stream_status":
+                    summary["meter_contract"]["subscribed"] = bool(payload.get("subscribed"))
+                    if payload.get("live_write") is True:
+                        summary["meter_contract"]["live_write_frames"] += 1
+                elif payload_type == "meter_frame":
+                    channels = payload.get("channels") if isinstance(payload.get("channels"), list) else []
+                    summary["meter_contract"]["max_channel_count"] = max(
+                        int(summary["meter_contract"]["max_channel_count"]),
+                        len(channels),
+                    )
+                    if payload.get("read_only") is True:
+                        summary["meter_contract"]["read_only_frames"] += 1
+                    if payload.get("live_write") is True:
+                        summary["meter_contract"]["live_write_frames"] += 1
+                    if payload.get("available") is True:
+                        summary["meter_contract"]["available_frames"] += 1
+                elif payload_type == "dashboard_snapshot":
+                    fields = _dashboard_fields(payload)
+                    for key in ("has_connection", "has_master_bus", "has_analyzer"):
+                        summary["dashboard_contract"][key] = bool(
+                            summary["dashboard_contract"][key] or fields.get(key)
+                        )
+                    if fields.get("analyzer_available"):
+                        summary["dashboard_contract"]["analyzer_available_count"] += 1
+                    if fields.get("master_bus_available"):
+                        summary["dashboard_contract"]["master_bus_available_count"] += 1
+
+            await _send(ws, recorder, {"type": "unsubscribe_meters"})
+    except (OSError, TimeoutError, ConnectionError) as exc:
+        summary.update(
+            {
+                "status": "blocked",
+                "reason": "backend_connection_or_runtime_observation_failed",
+                "transport_failure": {"type": type(exc).__name__, "message": str(exc)},
+            }
+        )
+        recorder.write_summary(summary)
+        print(json.dumps(summary, indent=2, sort_keys=True, default=json_default))
+        return 1
+    finally:
+        summary["duration_actual_sec"] = round(time.monotonic() - started_monotonic, 3)
+        summary["finished_at"] = iso_now()
+
+    forbidden_sent = sorted(
+        {item for item in recorder.sent_request_types if item in WRITE_REQUEST_TYPES}
+    )
+    if forbidden_sent:
+        summary.update(
+            {
+                "status": "failed",
+                "reason": "observation_runner_sent_forbidden_request",
+                "forbidden_request_types_sent": forbidden_sent,
+            }
+        )
+        recorder.write_summary(summary)
+        print(json.dumps(summary, indent=2, sort_keys=True, default=json_default))
+        return 3
+    if summary["counts"]["unexpected_live_event"]:
+        summary.update(
+            {
+                "status": "manual_review_required",
+                "reason": "unexpected_live_event_observed_during_runtime_monitor",
+            }
+        )
+        recorder.write_summary(summary)
+        print(json.dumps(summary, indent=2, sort_keys=True, default=json_default))
+        return 4
+    if summary["counts"]["dashboard_snapshot"] <= 0 or summary["counts"]["meter_frame"] <= 0:
+        summary.update(
+            {
+                "status": "blocked",
+                "reason": "dashboard_or_meter_telemetry_missing",
+            }
+        )
+        recorder.write_summary(summary)
+        print(json.dumps(summary, indent=2, sort_keys=True, default=json_default))
+        return 5
+
+    summary.update(
+        {
+            "status": "passed",
+            "reason": "read_only_soundcheck_runtime_observation_passed",
+            "forbidden_request_types_sent": [],
+            "write_request_sent": False,
+            "live_apply_request_sent": False,
+        }
+    )
+    recorder.write_summary(summary)
+    print(json.dumps(summary, indent=2, sort_keys=True, default=json_default))
+    return 0
+
+
+def main(argv: Optional[list[str]] = None) -> int:
+    args = build_parser().parse_args(argv)
+    return asyncio.run(run(args))
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tools/soundcheck_long_run_drift_audit.py b/tools/soundcheck_long_run_drift_audit.py
new file mode 100644
index 000000000..c62fafb4d
--- /dev/null
+++ b/tools/soundcheck_long_run_drift_audit.py
@@ -0,0 +1,342 @@
+#!/usr/bin/env python3
+"""Audit long-run soundcheck proposal logs for drift-prone actions.
+
+The audit is offline only. It reads JSONL evidence from prior observation or
+proposal loops and writes a summary artifact. A passing audit proves only that
+the supplied log stayed within the proposal/drift contract; it does not grant
+WING readiness or live authority.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import re
+import sys
+from collections import defaultdict
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any, Dict, Iterable, Iterator, List, Optional, Tuple
+
+
+DEFAULT_ARTIFACT_ROOT = "artifacts/soundcheck_long_run_drift_audit"
+DEFAULT_MIN_DURATION_SEC = 600.0
+DEFAULT_MAX_CUMULATIVE_DB = 3.0
+EPSILON_DB = 1e-9
+
+ACTION_COLLECTIONS = ("applied", "proposals", "proposed", "recommendations")
+ABSOLUTE_TARGET_KEYS = (
+    "target_fader_db",
+    "target_trim_db",
+    "target_gain_db",
+    "target_value_db",
+    "target_db",
+    "new_value_db",
+    "absolute_target_db",
+)
+
+
+def utc_stamp() -> str:
+    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
+
+
+def iso_now() -> str:
+    return datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")
+
+
+def _safe_float(value: Any) -> Optional[float]:
+    try:
+        number = float(value)
+    except (TypeError, ValueError):
+        return None
+    if not math.isfinite(number):
+        return None
+    return number
+
+
+def _read_jsonl(path: Path) -> Iterator[Tuple[int, Dict[str, Any]]]:
+    with path.open("r", encoding="utf-8") as handle:
+        for line_number, line in enumerate(handle, start=1):
+            stripped = line.strip()
+            if not stripped:
+                continue
+            try:
+                payload = json.loads(stripped)
+            except json.JSONDecodeError as exc:
+                yield line_number, {
+                    "audit_parse_error": True,
+                    "error": f"invalid_json:{exc.msg}",
+                    "raw": stripped[:200],
+                }
+                continue
+            if isinstance(payload, dict):
+                yield line_number, payload
+            else:
+                yield line_number, {"audit_parse_error": True, "error": "jsonl_row_not_object"}
+
+
+def _record_value(value: Any) -> Dict[str, Any]:
+    return value if isinstance(value, dict) else {}
+
+
+def _nested_search(mapping: Dict[str, Any], keys: Iterable[str]) -> Optional[float]:
+    key_set = set(keys)
+    stack: List[Any] = [mapping]
+    while stack:
+        value = stack.pop()
+        if isinstance(value, dict):
+            for key, item in value.items():
+                if key in key_set:
+                    number = _safe_float(item)
+                    if number is not None:
+                        return number
+                if isinstance(item, (dict, list)):
+                    stack.append(item)
+        elif isinstance(value, list):
+            stack.extend(value)
+    return None
+
+
+def _relative_move_db(action: Dict[str, Any]) -> Optional[float]:
+    params = _record_value(action.get("parameters"))
+    proposed = _record_value(action.get("proposed_action"))
+    for source in (params, proposed, action):
+        for key in ("gain_db", "delta_db", "move_db", "value_db"):
+            number = _safe_float(source.get(key))
+            if number is not None:
+                return number
+    return None
+
+
+def _absolute_target_db(action: Dict[str, Any]) -> Optional[float]:
+    return _nested_search(action, ABSOLUTE_TARGET_KEYS)
+
+
+def _surface_id(action: Dict[str, Any]) -> str:
+    action_id = str(action.get("id") or action.get("proposal_id") or "").strip()
+    target = str(action.get("target") or "").strip()
+    if action_id:
+        return action_id
+    if target:
+        return target
+    return str(action.get("action_type") or "unknown").strip() or "unknown"
+
+
+def _surface_kind(action: Dict[str, Any]) -> str:
+    surface = _surface_id(action).lower()
+    target = str(action.get("target") or "").lower()
+    action_type = str(action.get("action_type") or "").lower()
+    if surface.startswith("eq.") or ".eq." in target or "/eq/" in target:
+        return "eq"
+    if surface.startswith("fader.") or target.endswith(".fdr") or ".fdr" in target:
+        return "fader"
+    if surface.startswith("trim.") or re.fullmatch(r"ch\d+", target):
+        return "trim"
+    if "gain" in action_type or "trim" in action_type:
+        return "gain"
+    return action_type or "other"
+
+
+def _safety_gate(action: Dict[str, Any]) -> Dict[str, Any]:
+    return _record_value(_record_value(action.get("metadata")).get("safety_gate"))
+
+
+def _action_rows(event: Dict[str, Any]) -> Iterator[Tuple[str, Dict[str, Any]]]:
+    for collection in ACTION_COLLECTIONS:
+        rows = event.get(collection)
+        if isinstance(rows, list):
+            for row in rows:
+                if isinstance(row, dict):
+                    yield collection, row
+    blocked = event.get("blocked")
+    if isinstance(blocked, list):
+        for row in blocked:
+            if not isinstance(row, dict):
+                continue
+            decision = row.get("decision")
+            if isinstance(decision, dict):
+                yield "blocked.decision", decision
+
+
+def build_audit_summary(
+    evidence_paths: Iterable[Path],
+    *,
+    min_duration_sec: float = DEFAULT_MIN_DURATION_SEC,
+    max_cumulative_db: float = DEFAULT_MAX_CUMULATIVE_DB,
+) -> Dict[str, Any]:
+    paths = [Path(path) for path in evidence_paths]
+    events = 0
+    parse_errors: List[Dict[str, Any]] = []
+    cycles: List[int] = []
+    timestamps: List[float] = []
+    actions = 0
+    applied_actions = 0
+    live_executor_actions = 0
+    positive_fader_boosts: List[Dict[str, Any]] = []
+    positive_gain_boosts: List[Dict[str, Any]] = []
+    relative_target_actions: List[Dict[str, Any]] = []
+    cumulative_relative_db: Dict[str, float] = defaultdict(float)
+    action_counts_by_surface: Dict[str, int] = defaultdict(int)
+    action_counts_by_collection: Dict[str, int] = defaultdict(int)
+
+    for path in paths:
+        for line_number, event in _read_jsonl(path):
+            events += 1
+            if event.get("audit_parse_error"):
+                parse_errors.append({"path": str(path), "line": line_number, "error": event.get("error")})
+                continue
+            cycle = event.get("cycle")
+            if isinstance(cycle, int):
+                cycles.append(cycle)
+            event_time = _safe_float(event.get("t"))
+            if event_time is not None:
+                timestamps.append(event_time)
+            for collection, action in _action_rows(event):
+                actions += 1
+                action_counts_by_collection[collection] += 1
+                surface = _surface_id(action)
+                kind = _surface_kind(action)
+                move_db = _relative_move_db(action)
+                absolute_target = _absolute_target_db(action)
+                action_counts_by_surface[surface] += 1
+                if collection == "applied":
+                    applied_actions += 1
+                    gate = _safety_gate(action)
+                    dry_run = gate.get("dry_run")
+                    executor = gate.get("send_to_executor")
+                    if dry_run is not True and executor is not False:
+                        live_executor_actions += 1
+                if move_db is not None and move_db > EPSILON_DB:
+                    row = {
+                        "path": str(path),
+                        "line": line_number,
+                        "surface": surface,
+                        "kind": kind,
+                        "move_db": move_db,
+                        "collection": collection,
+                    }
+                    if kind == "fader":
+                        positive_fader_boosts.append(row)
+                    elif kind in {"trim", "gain"}:
+                        positive_gain_boosts.append(row)
+                if kind in {"fader", "trim", "gain"} and absolute_target is None:
+                    relative_target_actions.append(
+                        {
+                            "path": str(path),
+                            "line": line_number,
+                            "surface": surface,
+                            "kind": kind,
+                            "move_db": move_db,
+                            "collection": collection,
+                        }
+                    )
+                    if move_db is not None:
+                        cumulative_relative_db[surface] += move_db
+
+    duration_sec = 0.0
+    if timestamps:
+        duration_sec = round(max(timestamps) - min(timestamps), 3)
+    cumulative_drift = [
+        {"surface": surface, "cumulative_relative_db": round(value, 3)}
+        for surface, value in sorted(cumulative_relative_db.items())
+        if abs(value) > max_cumulative_db + EPSILON_DB
+    ]
+    failures: List[str] = []
+    if parse_errors:
+        failures.append("invalid_jsonl_rows")
+    if duration_sec < min_duration_sec:
+        failures.append("duration_below_minimum")
+    if actions == 0:
+        failures.append("proposal_actions_missing")
+    if live_executor_actions:
+        failures.append("live_executor_actions_present")
+    if positive_fader_boosts:
+        failures.append("positive_fader_boosts_present")
+    if positive_gain_boosts:
+        failures.append("positive_gain_or_trim_boosts_present")
+    if relative_target_actions:
+        failures.append("relative_only_targets_present")
+    if cumulative_drift:
+        failures.append("cumulative_relative_drift_present")
+
+    status = "passed" if not failures else "failed"
+    return {
+        "schema": "soundcheck_long_run_drift_audit.v1",
+        "generated_at": iso_now(),
+        "status": status,
+        "failures": failures,
+        "proof_scope": "offline_log_audit_only_no_wing_readiness",
+        "live_authority_granted": False,
+        "readiness_closure_allowed": False,
+        "readiness_matrix_update_allowed": False,
+        "evidence_paths": [str(path) for path in paths],
+        "min_duration_sec": min_duration_sec,
+        "duration_sec": duration_sec,
+        "event_count": events,
+        "cycle_count": len(set(cycles)),
+        "cycle_min": min(cycles) if cycles else None,
+        "cycle_max": max(cycles) if cycles else None,
+        "action_count": actions,
+        "applied_action_count": applied_actions,
+        "live_executor_action_count": live_executor_actions,
+        "positive_fader_boost_count": len(positive_fader_boosts),
+        "positive_gain_or_trim_boost_count": len(positive_gain_boosts),
+        "relative_only_target_count": len(relative_target_actions),
+        "cumulative_drift_surface_count": len(cumulative_drift),
+        "max_cumulative_db": max_cumulative_db,
+        "action_counts_by_collection": dict(sorted(action_counts_by_collection.items())),
+        "action_counts_by_surface": dict(sorted(action_counts_by_surface.items())),
+        "positive_fader_boosts": positive_fader_boosts[:50],
+        "positive_gain_or_trim_boosts": positive_gain_boosts[:50],
+        "relative_only_targets": relative_target_actions[:50],
+        "cumulative_relative_drift": cumulative_drift[:50],
+        "parse_errors": parse_errors[:50],
+    }
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(description="Audit soundcheck long-run drift evidence.")
+    parser.add_argument("evidence", nargs="+", help="JSONL evidence files to audit")
+    parser.add_argument("--artifact-root", default=DEFAULT_ARTIFACT_ROOT)
+    parser.add_argument("--min-duration-sec", type=float, default=DEFAULT_MIN_DURATION_SEC)
+    parser.add_argument("--max-cumulative-db", type=float, default=DEFAULT_MAX_CUMULATIVE_DB)
+    return parser
+
+
+def main(argv: Optional[List[str]] = None) -> int:
+    args = build_parser().parse_args(argv)
+    evidence_paths = [Path(item) for item in args.evidence]
+    missing = [str(path) for path in evidence_paths if not path.exists()]
+    run_id = f"{utc_stamp()}_soundcheck_long_run_drift_audit"
+    run_dir = Path(args.artifact_root) / run_id
+    run_dir.mkdir(parents=True, exist_ok=True)
+    summary_path = run_dir / "summary.json"
+    if missing:
+        summary = {
+            "schema": "soundcheck_long_run_drift_audit.v1",
+            "generated_at": iso_now(),
+            "status": "blocked",
+            "failures": ["evidence_file_missing"],
+            "proof_scope": "offline_log_audit_only_no_wing_readiness",
+            "missing_evidence_paths": missing,
+            "live_authority_granted": False,
+            "readiness_closure_allowed": False,
+            "readiness_matrix_update_allowed": False,
+        }
+    else:
+        summary = build_audit_summary(
+            evidence_paths,
+            min_duration_sec=args.min_duration_sec,
+            max_cumulative_db=args.max_cumulative_db,
+        )
+    summary["summary_path"] = str(summary_path)
+    with summary_path.open("w", encoding="utf-8") as handle:
+        json.dump(summary, handle, ensure_ascii=False, indent=2, sort_keys=True)
+        handle.write("\n")
+    print(json.dumps(summary, ensure_ascii=False, indent=2, sort_keys=True))
+    return 0 if summary["status"] == "passed" else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
