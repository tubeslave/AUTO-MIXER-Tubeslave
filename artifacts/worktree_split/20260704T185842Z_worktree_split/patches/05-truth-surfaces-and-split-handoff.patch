++SAFE_DISCONNECT_REQUEST_TYPES = {"disconnect_mixer", "disconnect_wing"}
++SAFE_BLOCK_REASONS = {
++    "mixer_not_connected",
++    "pre_read_unavailable",
++    "pre_read_cache_not_fresh",
++    "mixer_write_failed",
