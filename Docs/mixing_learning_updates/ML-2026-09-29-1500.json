    {
      "id": "KC-ML-20260929-1500-01",
      "claim": "If raw amplitude carries target-parameter information, peak normalisation can reduce identifiability; this does not justify raw gain as a creative matching objective.",
      "confidence": "high_within_simulated_task"
    },
    {
      "id": "KC-ML-20260929-1500-02",
      "claim": "Per-observation refinement can improve median error while worsening mean error through rare catastrophic failures; report tail risk.",
      "confidence": "high_within_reported_test"
    },
    {
      "id": "KC-ML-20260929-1500-03",
      "claim": "Waveform reconstruction error is an imperfect proxy for physical-parameter error and selectors need target-level failure analysis.",
      "confidence": "high_within_reported_test"
    },
    {
      "id": "KC-ML-20260929-1500-04",
      "claim": "Offline posterior calibration does not establish refined-posterior calibration.",
      "confidence": "high"
    },
    {
      "id": "KC-ML-20260929-1500-05",
      "claim": "Exact-simulator performance does not establish measured-plate, noisy, model-mismatched, mix-quality or preference performance.",
      "confidence": "high"
    },
    {
      "id": "KC-ML-20260929-1500-06",
      "claim": "A drum-room role can be split into low-frequency weight and midrange ambience; filtering is context-bound.",
      "confidence": "medium"
    },
    {
      "id": "KC-ML-20260929-1500-07",
      "claim": "Selective close-mic sends can define synthetic-room excitation independently of dry faders, subject to routing and musical checks.",
      "confidence": "medium"
    },
