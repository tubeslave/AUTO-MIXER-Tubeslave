    {"id":"KC-ML-20261013-0900-01","claim":"Separate whether-to-edit from which-offset selection to reduce blanket changes; evidence is pipeline-specific.","confidence":"medium"},
    {"id":"KC-ML-20261013-0900-02","claim":"Report both error repair and initially-correct-note harm; accuracy alone is insufficient.","confidence":"high_within_protocol"},
    {"id":"KC-ML-20261013-0900-03","claim":"Soft tonal reranking with an unchanged candidate is safer evidence than hard key snapping in this study.","confidence":"medium"},
    {"id":"KC-ML-20261013-0900-04","claim":"A professional performance is a reference, not absolute expressive-pitch ground truth.","confidence":"high"},
    {"id":"KC-ML-20261013-0900-05","claim":"Integer-semitone symbolic editing does not validate preservation of microtonal expressive details or formants.","confidence":"high"},
    {"id":"KC-ML-20261013-0900-06","claim":"Subjective means without reported inference do not establish a reliable preference difference.","confidence":"high"},
    {"id":"KC-ML-20261013-0900-07","claim":"Tape and saturation demonstrations require raw level-matched controls before causal attribution.","confidence":"high"},
    {"id":"KC-ML-20261013-0900-08","claim":"A gated fully-wet short-room return is a section- and source-dependent ambience option, not a default chain.","confidence":"medium_low"}
  ],
  "rules_add": [
    {
      "id": "RULE-ML-20261013-0900-01",
      "name": "vocal_pitch_sparse_edit_shadow_only",
      "applies_when": "project-owned exposed lead vocal; section role declared; stable note; one gross error independently approved; no intentional expressive pitch target",
      "change": "compare bypass with one sealed note-region and one fixed integer-semitone offset; never hard-snap the full performance",
      "proposed_range": "one manually justified +/-1 semitone edit for first project test",
      "range_origin": "engineering_safety_hypothesis_within_source_candidate_set_0_+/-1_+/-2_+/-3",
      "protected_qualities": ["timing","groove","consonants","formants","timbre","vibrato","transition_continuity","harmony_role","emotion","true_peak","section_loudness"],
      "verify": "unmatched raw renders plus separate BS.1770-matched true-peak-safe blinded solo and full-mix copies",
      "cancel": "uncertain target, expressive-intent conflict, artifact, protected regression, loudness-only benefit, or worse harmony/section role",
      "confidence": "medium_low_for_project_transfer",
      "auto_apply": false
    }
  ],
