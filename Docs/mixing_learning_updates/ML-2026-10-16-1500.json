  "knowledge_cards_added": [
    {
      "id": "KC-ML-20261016-1500-01",
      "claim": "Audio-to-code retrieval ranks topology hypotheses; it does not recover a unique chain, exact settings or mix quality."
    },
    {
      "id": "KC-ML-20261016-1500-02",
      "claim": "Inactive effects can be unidentifiable; activity checks must accompany evaluation."
    },
    {
      "id": "KC-ML-20261016-1500-03",
      "claim": "Mid/side magnitude features cannot distinguish mirror panning; stereo direction needs direction-sensitive features."
    },
    {
      "id": "KC-ML-20261016-1500-04",
      "claim": "Loudness-normalized embeddings cannot support gain or compression-setting recovery without raw cues."
    },
    {
      "id": "KC-ML-20261016-1500-05",
      "claim": "Out-of-distribution RIR retrieval does not establish transfer to dynamics, nonlinear or stereo effects."
    },
    {
      "id": "KC-ML-20261016-1500-06",
      "claim": "Prompt-distinct structured mappings support candidate generation, not semantic truth or listening preference."
    },
    {
      "id": "KC-ML-20261016-1500-07",
      "claim": "Generated configurations require finite-sample, peak and silence gates before measurement or listening."
    },
    {
      "id": "KC-ML-20261016-1500-08",
      "claim": "Signal proxies and CLAP on one performance do not establish perceptual or section-level generalization."
    }
  ],
