    {"id":"KC-ML-20260917-1800-03","claim":"The method's transient result changes with stretch direction and ratio; 0.5 compression cannot inherit the 1.8 expansion result.","evidence":["S-ML-20260917-1500-02"],"confidence":0.98},
    {"id":"KC-ML-20260917-1800-04","claim":"Silence or sparse extrema before a transient can create long splices and audible repeated segments.","evidence":["S-ML-20260917-1500-02"],"confidence":0.97},
    {"id":"KC-ML-20260917-1800-05","claim":"Analytical cycle estimates do not establish target-device callback safety or end-to-end latency.","evidence":["S-ML-20260917-1500-02"],"confidence":0.99},
    {"id":"KC-ML-20260917-1800-06","claim":"Isolated RTF can materially underpredict real DAW callback deadline failures.","evidence":["S-ML-20260917-1500-04"],"confidence":0.99},
    {"id":"KC-ML-20260917-1800-07","claim":"Tail callback utilization and Core Audio xruns are required alongside median throughput for deployment decisions.","evidence":["S-ML-20260917-1500-04"],"confidence":0.99},
    {"id":"KC-ML-20260917-1800-08","claim":"Asynchronous inference underruns and zero/stale output substitution can occur without equivalent audio-thread timing evidence.","evidence":["S-ML-20260917-1500-04"],"confidence":0.99},
    {"id":"KC-ML-20260917-1800-09","claim":"Backend ranking depends on architecture, model size, buffer, instance count and host contention; no universal winner is supported.","evidence":["S-ML-20260917-1500-04"],"confidence":0.99},
